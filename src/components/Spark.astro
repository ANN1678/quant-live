---
// 24時間の足を1本の線にする。目盛りは出さない（読ませるのは形だけ）。
interface Props { points: number[]; w?: number; h?: number; color?: string; }
const { points, w = 260, h = 44, color = '#5f5e5a' } = Astro.props;
const lo = Math.min(...points), hi = Math.max(...points);
const span = hi - lo || 1;
const xy = points.map((p, i) => [
  (i / (points.length - 1 || 1)) * w,
  h - ((p - lo) / span) * (h - 3) - 1.5,
] as [number, number]);
const line = xy.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L${w} ${h} L0 ${h} Z`;
const id = `sp${Math.random().toString(36).slice(2, 8)}`;
---
<svg viewBox={`0 0 ${w} ${h}`} width="100%" height={h} preserveAspectRatio="none" aria-hidden="true" style="display:block;margin-top:14px">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color={color} stop-opacity="0.13" />
      <stop offset="100%" stop-color={color} stop-opacity="0" />
    </linearGradient>
  </defs>
  <path d={area} fill={`url(#${id})`} />
  <path d={line} fill="none" stroke={color} stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
</svg>
