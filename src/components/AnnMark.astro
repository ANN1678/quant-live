---
// 株式会社ANN のロゴマーク。正本＝ANN/outputs/brand/logo/ann-logo.svg
// ⚠ 字を <text> に戻さない（Jost が無い環境で化ける）。三角と字を1本のパスに合成しない
//    （nonzero 前提の輪郭なので evenodd にすると「A」の横棒が抜ける）。mask 構造のまま触らない。
interface Props { id: string; size?: number; class?: string; }
const { id, size = 22, class: cls } = Astro.props;
---
<svg
  class={cls}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 100 88"
  width={size}
  height={(size * 88) / 100}
  role="img"
  aria-label="株式会社ANN"
>
  <mask id={id}>
    <rect width="100" height="88" fill="#fff" />
    <path fill="#000" d="M44.51 44.6H55.61L54.949999999999996 41.6H45.199999999999996ZM50.0 34.94 53.36 42.74 53.42 43.61 56.269999999999996 50.0H60.29L50.0 27.830000000000002L39.74 50.0H43.73L46.64 43.43L46.699999999999996 42.65Z M43.18 57.0V71.1L27.85 55.95V78.0H31.330000000000002V63.9L46.66 79.05V57.0Z M67.67 57.0V71.1L52.34 55.95V78.0H55.82V63.9L71.15 79.05V57.0Z" />
  </mask>
  <path fill="currentColor" mask={`url(#${id})`} d="M50 4 L96 84 L4 84 Z" />
</svg>
