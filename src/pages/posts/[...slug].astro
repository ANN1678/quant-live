---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', year: 'numeric', month: 'long', day: 'numeric' }).format(d);
const url = `https://ann1678.com/posts/${post.id}/`;
const article = {
  '@type': 'BlogPosting',
  '@id': `${url}#article`,
  headline: post.data.title,
  description: post.data.summary,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  inLanguage: 'ja',
  mainEntityOfPage: url,
  image: 'https://ann1678.com/og.png',
  author: { '@id': 'https://ann1678.com/#org' },
  publisher: { '@id': 'https://ann1678.com/#org' },
  isPartOf: { '@id': 'https://ann1678.com/posts/#blog' },
};
const crumbs = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '実況', item: 'https://ann1678.com/' },
    { '@type': 'ListItem', position: 2, name: '手記', item: 'https://ann1678.com/posts/' },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: url },
  ],
};
---
<Base
  title={`${post.data.title}｜ANN`}
  description={post.data.summary ?? '相場の予測と仮想売買の記録から、数字だけでは残らないことを書いています。'}
  ogType="article"
  jsonld={[article, crumbs]}
  theme="light"
>
  <article class="prose">
    <div class="hero">
      <span class="eyebrow">{fmt(post.data.date)}</span>
      <h1>{post.data.title}</h1>
      {post.data.summary && <p class="lead">{post.data.summary}</p>}
    </div>
    <div class="section article-body">
      <Content />
    </div>
  </article>
  <p style="margin-top:64px"><a class="cta" href="/posts/">手記の一覧へ<span class="arw" aria-hidden="true">→</span></a></p>
</Base>
