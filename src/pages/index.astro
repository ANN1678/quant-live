---
import Base from '../layouts/Base.astro';
import Spark from '../components/Spark.astro';
import GateScale from '../components/GateScale.astro';
import Equity from '../components/Equity.astro';
import { summary, market, equity, results, DIRECTION_LABEL, PAIR_LABEL, jst, pct, yen } from '../lib/data';

const gate = summary?.gate ?? null;
const pred = summary?.predictions?.all ?? null;
const trade = summary?.trading?.all ?? null;
const pairs = Object.entries(market?.pairs ?? {}) as [string, any][];
const open = pairs.map(([k, v]) => v.position).filter(Boolean);
const recent = results.filter((r) => !summary?.model || r.model === summary.model).sort((a, b) => b.target_t - a.target_t).slice(0, 12);
const hasAvg = gate?.avg_net_pct !== null && gate?.avg_net_pct !== undefined;
const perPair = Object.entries(gate?.per_pair ?? {}) as [string, any][];
const sign = (n: number | null | undefined) => (n === null || n === undefined ? 'flat' : n > 0 ? 'up' : n < 0 ? 'down' : 'flat');
const firstCheck = gate?.checkpoints?.[0] ?? 50;
// いまのモデルと規則で買った分か。前の規則の分は持ち越さずに売り、1回あたりの損益にも数えない（report.py が model と rule で分けている）
const isCurrent = (p: any) => p.model === summary?.model && p.rule === summary?.rule;
// まだ1件も終わっていないとき、いつ最初の1件が出るかを言うために使う。
// ⚠ 前の規則の分を拾わない。拾うと、数えない売買の期限を「最初の1件」と書いてしまう（2026-09-13）
const firstClose = open.filter(isCurrent).map((p: any) => p.close_at).sort()[0] ?? null;
// ヒーローの2枠。どちらも「次に何が起きるか」を出す。エンジンの側の経過時間は出さない
const lastRunT = summary?.generated_at ? Date.parse(summary.generated_at) : null;
// 次にエンジンが回る時刻。合図は Xserver の cron が毎時5分に出している（README の「仕組み」）。
// ⚠ 「いまから次の5分」で出さない。エンジンが止まっても1時間以内の数字が出て、止まったことが隠れる。
//    最後に回った時刻の「次の時」の5分で出す。止まれば、そのぶんマイナスになって表に出る。
// ⚠ setMinutes(0,0,0) で丸めない。組む機械の時間帯で結果が変わる（Actionsは協定世界時・手元は日本時間）。
//    日本時間は正時ちょうどのずれなので、エポックを時間で床に落とせば、どちらで組んでも同じ時刻になる。
const nextRunT = lastRunT === null ? null
  : Math.floor(lastRunT / 3600000) * 3600000 + 3600000 + 5 * 60000;
// 相場の線の両端の日時と、線の色。色は線の端から端で決める（上の「24時間で」とは期間が違う）。
// 足の t は始まりの時刻で、終値はその1時間後の値なので、両端とも1時間足す
const lineSpan = (cs: any[]) => cs.length === 0
  ? { from: undefined, to: undefined, up: true }
  : { from: jst(cs[0].t + 3600000), to: jst(cs[cs.length - 1].t + 3600000), up: cs[cs.length - 1].c >= cs[0].c };
// 関門の目盛りは、成績がまだ無い銘柄も0件として出す
const gateRows: [string, any][] = perPair.length > 0 ? perPair : pairs.map(([k]) => [k, null]);
---
<Base
  title="ANN｜ビットコインの予測と仮想売買の記録を全部公開"
  description="ビットコインとイーサリアムが72時間後に上がるか下がるかを1時間ごとに予測し、そのとおりに売買したことにして損得を数えています。当たった回も外した回も全件そのまま公開。リアルに移行する条件も数字で書いています。"
>
  <div class="hero">
    <span class="eyebrow"><span class="n">LIVE</span> ／ 1時間ごとに書き換えています</span>
    <h1>仮想通貨で勝てる<br />モデルをつくる。</h1>
    <p class="lead">モデルが本物なら、手数料を引いた後でも資金は増えます。増えたかどうかを、400回ぶん数えます。まぐれと区別がつくほどプラスなら、そこでリアルに移る。当たった回も外した回も、消さずに出します。</p>

    {/* ⚠ 玉は1銘柄につき1つまでなので、この列は最大3つになる。2つ持っているときだけ c3 にする */}
    <div class={`stats ${open.length > 1 ? 'c3' : 'c2'} ticks`}>
      {nextRunT && (
        <div
          class="stat"
          data-count={nextRunT}
          data-label="次に数字が入れ替わるまで"
          data-label-late="予定より遅れています"
        >
          <div class="kj">次に数字が入れ替わるまで</div>
          <div class="v tv">--:--:--</div>
          <div class="n">エンジンは毎時5分に回ります。回るたびに、このページの数字を全部組み直します。最後に回ったのは {jst(summary?.generated_at)} です</div>
        </div>
      )}
      {open.length === 0 ? (
        <div class="stat">
          <div class="kj">いま買っているもの</div>
          <div class="v long">何も買っていません</div>
          <div class="n">下がる、または決めきれない、と読んだときは買わないからです。次に決めるのは、次の1時間が終わったときです</div>
        </div>
      ) : open.map((p: any) => (
        <div class="stat">
          <div class="kj">いま買っているもの　{PAIR_LABEL[p.pair] ?? p.pair}</div>
          <div class={`v ${sign(p.unrealized_pct)}`}>{pct(p.unrealized_pct, 2)}</div>
          {isCurrent(p) ? (
            <div class="n">{yen(p.entry)}円で買ったことにしています。この損得は、売るまで確定しません。{jst(p.close_at)}に、売るか持ち続けるかを決めます{p.seg > 1 ? `（${p.seg}回目の持ち越し）` : ''}</div>
          ) : (
            <div class="n">{yen(p.entry)}円で買ったことにしています。前の規則で買った分なので、{jst(p.close_at)}に売ります。1回あたりの損益には数えません</div>
          )}
        </div>
      ))}
    </div>
  </div>

  <section class="section">
    <span class="eyebrow"><span class="n">01</span> ／ 仕組み</span>
    <h2>何をしているか</h2>
    <p class="lead">やることは3つです。予測を書く。仮想で買う。3日後に数える。これを1時間ごとに繰り返しています。</p>

    <div class="stats c3">
      <div class="stat">
        <div class="kj">1　予測する</div>
        <div class="v long">上がるか下がるかを決める</div>
        <div class="n">ビットコインとイーサリアムが72時間後に上がるか下がるかを、1時間ごとに決めます。決めきれない回は FLAT にします。答えが出る前に、公開のリポジトリへ書き込みます。</div>
      </div>
      <div class="stat">
        <div class="kj">2　仮想で買う</div>
        <div class="v long">上がると読んだ回だけ買う</div>
        <div class="n">仮想の資金は100万円から始めました。1回に使うのはその10%です。取引所に注文は出していない。手数料と、思った値で買えないぶんを、多めに見て引きます。</div>
      </div>
      <div class="stat">
        <div class="kj">3　数える</div>
        <div class="v long">3日後に答え合わせをする</div>
        <div class="n">当たったか外したかを記録します。そのときもまだ上がると読んでいれば、売らずに持ち続けます。1回あたりいくら増えたかを数えます。</div>
      </div>
    </div>

    <div class="note">ここにあるのは記録だけです。銘柄を勧めることも、予測を売ることもしない。投資の助言ではありません。</div>
  </section>

  <section class="section">
    <span class="eyebrow"><span class="n">02</span> ／ 決め方</span>
    <h2>いつリアルに移行するか</h2>
    <p class="lead">いまは1円も動かしていない。売買を400回まで数えて、1回あたりの損得がまぐれでは説明できないほどプラスなら、そこで初めて現金を出します。<strong>的中率では決めない。</strong>外すほうが多くても、勝った回の値幅が大きければ資金は増えるからです。</p>

    <div class="panel" style="margin-top:38px">
      <span class="eyebrow">1回あたりの平均損益（手数料などを引いた後）</span>
      {hasAvg ? (
        <p class="readout" style={sign(gate?.avg_net_pct) === 'up' ? 'color:var(--up)' : sign(gate?.avg_net_pct) === 'down' ? 'color:var(--down)' : ''}>
          {pct(gate.avg_net_pct, 3)}
        </p>
      ) : (
        <p class="readout pending">まだ1件も終わっていません。{firstClose ? `${jst(firstClose)}に最初の1件が出ます。` : 'いまの規則では、まだ1回も買っていません。上がると読んだ回に買って、その3日後に最初の1件が出ます。'}</p>
      )}

      <div class="gates">
        {gateRows.map(([pair, v]) => (
          <GateScale
            label={PAIR_LABEL[pair] ?? pair}
            trades={v?.trades ?? 0}
            checkpoints={gate?.checkpoints ?? [50, 100, 200, 400]}
            next={v?.next_checkpoint ?? firstCheck}
            t={v?.t ?? null}
            threshold={gate?.threshold_t ?? 2.36}
            verdicts={v?.verdicts ?? []}
          />
        ))}
      </div>
      <p class="fine" style="margin:30px 0 0">同時に持つのは1銘柄につき1つだけです。72時間ごとに見直します。件数は銘柄ごとに数えます。</p>

      <p class="fine" style="margin:34px 0 0">まぐれかどうかは <span class="mono">t</span> という数で見ます。勝った幅が大きいほど、ばらつきが小さいほど、件数が多いほど t は大きくなります。平均がプラスでも、件数が少なければ t は小さいままです。<strong>t が {gate?.threshold_t ?? 2.36} 以上で合格にします。</strong></p>
      <p class="fine" style="margin:14px 0 0">逆もあります。この予測が本当に効いていても、400件のうちに気づけるのは4割ほどです。不合格でも、効いていないと決まったわけではない。数え方は<a href="/method/">やり方</a>に全部書きました。</p>
      <p class="fine" style="margin:14px 0 0">検査するのは4回だけです。ビットコインとイーサリアムのそれぞれで、50件・100件・200件・400件たまったときに見ます。毎時間ながめて、いちばん成績のいいときに合格を出すこともできます。それをやると、まぐれでも3回に1回は合格が出てしまう。だから見る回数を先に決めました。</p>
    </div>
  </section>


  <section class="section">
    <span class="eyebrow"><span class="n">03</span> ／ 相場</span>
    <h2>ビットコインとイーサリアムの値段</h2>
    <div class="stats c2">
      {pairs.map(([key, v]) => (
        <div class="stat">
          <div class="kj">{PAIR_LABEL[key] ?? key}</div>
          <div class="v long">{yen(v.ticker.last)}<span class="unit">円</span></div>
          <div class="n">{jst(v.ticker.t)}までの24時間で {pct(((v.ticker.last - v.ticker.open) / v.ticker.open) * 100)}</div>
          <Spark
            points={v.candles.map((c: any) => c.c)}
            color={lineSpan(v.candles).up ? 'var(--up)' : 'var(--down)'}
            from={lineSpan(v.candles).from}
            to={lineSpan(v.candles).to}
          />
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <span class="eyebrow"><span class="n">04</span> ／ 成績</span>
    <h2>いまの成績</h2>
    <p class="lead">的中率は、出した予測が当たった割合です。勝率は、実際に買った取引が手数料を引いた後でプラスだった割合です。予測は1時間ごとに出します。買うのは前の取引が終わっていて、上がると読んだときだけです。だから2つの件数はそろいません。</p>
    <div class="stats c4">
      <div class="stat">
        <div class="kj">予測の的中率</div>
        <div class="v">{pred?.hit_rate === null || pred?.hit_rate === undefined ? <span class="na">—</span> : `${pred.hit_rate}%`}</div>
        <div class="n">判定した {pred?.judged ?? 0} 件のうち {pred?.hits ?? 0} 件。72件おきに1件だけ取って数え直すと {pred?.nonoverlap_hit_rate ?? '—'}%（{pred?.nonoverlap_judged ?? 0} 件）</div>
      </div>
      <div class="stat">
        <div class="kj">売買の勝率</div>
        <div class="v">{trade?.win_rate === null || trade?.win_rate === undefined ? <span class="na">—</span> : `${trade.win_rate}%`}</div>
        <div class="n">{trade?.trades ?? 0} 件のうち {trade?.wins ?? 0} 件</div>
      </div>
      <div class="stat">
        <div class="kj">勝ちと負けの比</div>
        <div class="v">{trade?.payoff ?? <span class="na">—</span>}</div>
        <div class="n">勝った回の平均 {pct(trade?.win_avg_pct)} ／ 負けた回の平均 {pct(trade?.loss_avg_pct)}</div>
      </div>
      <div class="stat">
        <div class="kj">仮想の資金</div>
        <div class="v long">{yen(summary?.capital?.now)}<span class="unit">円</span></div>
        <div class="n">{yen(summary?.capital?.start)}円から {pct(summary?.capital?.change_pct)}</div>
      </div>
    </div>
    {equity?.curve?.length >= 5 && (
      <div class="panel" style="margin-top:52px">
        <span class="eyebrow">仮想の資金の推移</span>
        <Equity curve={equity.curve} start={equity.start} />
        <p class="fine" style="margin-top:16px">点が増えるのは、売買が閉じたときだけです。破線は元手の {yen(equity?.start)}円を指しています。</p>
      </div>
    )}

    <p class="fine" style="margin-top:30px">的中率が2つあるのは、予測どうしが時間で重なっているからです。1時間ごとに出しますが、どれも72時間先を見ています。<strong>隣り合う予測は、71時間ぶん同じ値動きを見ている。</strong>だから何百件当てても、別々の出来事をその回数だけ当てたことにはなりません。重なりを消すには、72件おきに1件だけ取ります。それが2つ目の数字です。</p>
  </section>

  <section class="section">
    <span class="eyebrow"><span class="n">05</span> ／ 判定</span>
    <h2>直近の判定</h2>
    {recent.length === 0 ? (
      <p class="empty">まだ判定が終わった予測はありません。予測は72時間後に判定します。最初の判定は、記録を始めてから3日後に出ます。</p>
    ) : (
      <div class="scroll">
        <table>
          <thead><tr><th>判定した時刻</th><th>銘柄</th><th>予測</th><th>予測したときの値</th><th>72時間後の値</th><th>動き</th><th>結果</th></tr></thead>
          <tbody>
            {recent.map((r: any) => (
              <tr>
                <td class="ts">{jst(r.target_at)}</td>
                <td>{PAIR_LABEL[r.pair] ?? r.pair}</td>
                <td><span class={`tag ${r.direction}`}>{DIRECTION_LABEL[r.direction]}</span></td>
                <td class="num">{yen(r.base_price)}</td>
                <td class="num">{yen(r.target_price)}</td>
                <td class={`num ${sign(r.move_pct)}`}>{pct(r.move_pct)}</td>
                <td>{r.hit === null ? '—' : r.hit ? '的中' : '外れ'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
    <p style="margin-top:30px"><a class="cta" href="/record/">記録をすべて見る<span class="arw" aria-hidden="true">→</span></a></p>
  </section>


  <p class="eyebrow" style="margin-top:72px">最後に更新したのは {jst(summary?.generated_at)}</p>
</Base>
