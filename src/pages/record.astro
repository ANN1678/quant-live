---
import Base from '../layouts/Base.astro';
import Votes from '../components/Votes.astro';
import { results, trades, predictions, summary, DIRECTION_LABEL, PAIR_LABEL, jst, pct, yen } from '../lib/data';
const curModel = summary?.model;
const curRule = summary?.rule;
const isCur = (r: any) => !curModel || r.model === curModel;
const isCurTrade = (t: any) => !curRule || (t.rule === curRule && t.model === curModel);
const judged = results.filter(isCur).sort((a, b) => b.target_t - a.target_t);
const done = trades.filter(isCurTrade).sort((a, b) => b.close_t - a.close_t);
const open = predictions.filter((p) => !results.some((r) => r.id === p.id))
  .sort((a, b) => b.target_t - a.target_t);
const oldJudged = results.filter((r) => !isCur(r)).sort((a, b) => b.target_t - a.target_t);
const oldDone = trades.filter((t) => !isCurTrade(t)).sort((a, b) => b.close_t - a.close_t);
const oldModels = [...new Set([...oldJudged.map((r) => r.model), ...oldDone.map((t) => `${t.model}／${t.rule ?? 'close-72h-v1'}`)])];
const exec = summary?.execution ?? null;
const sign = (n: number | null | undefined) => (n === null || n === undefined ? '' : n > 0 ? 'up' : n < 0 ? 'down' : '');
// 記録そのものを構造化データにしておく。これが商品なので、検索側にも「何の記録か」を渡す。
const dataset = {
  '@type': 'Dataset',
  '@id': 'https://ann1678.com/record/#dataset',
  name: 'ANN：予測と仮想売買の全記録',
  description:
    'ビットコインとイーサリアムの72時間先の方向を1時間ごとに予測し、その結果と仮想売買の損益を全件記録したもの。追記のみで、公開後に書き換えていない。',
  license: 'https://ann1678.com/about/',
  isAccessibleForFree: true,
  creator: { '@id': 'https://ann1678.com/#org' },
  temporalCoverage: '2026-09-08/..',
  variableMeasured: ['予測の方向', '的中', '建値', '手仕舞い値', '手数料後の損益率'],
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/jsonl', contentUrl: 'https://github.com/ANN1678/quant-live/tree/main/data' }],
  dateModified: summary?.generated_at ?? undefined,
};
---
<Base
  title="記録｜出した予測と結果の全件｜ANN"
  description="判定を待っている予測、判定が終わった予測、仮想売買の全件を並べています。消したものも、書き換えたものもありません。順番は公開リポジトリの履歴が持っています。"
  jsonld={[dataset]}
>
  <div class="hero">
    <span class="eyebrow"><span class="n">RECORD</span> ／ 追記だけ</span>
    <h1>記録</h1>
    <p class="lead">出した予測と、その結果を全部並べています。都合の悪い回も同じ場所にあります。消したものはない。書き換えたものも無い。順番は<a href="https://github.com/ANN1678/quant-live/tree/main/data">公開リポジトリの履歴</a>が持っています。</p>
  </div>

  <section class="section">
    <span class="eyebrow"><span class="n">01</span> ／ 判定待ち　{open.length}件</span>
    <h2>まだ答えが出ていない予測</h2>
    <p class="lead">7日前・14日前・28日前と比べて、何本が上がっているかを数えます。上が多ければ「上」、下が多ければ「下」、半々なら見送りです。</p>
    <div class="scroll">
      <table>
        <thead><tr><th>出した時刻</th><th>銘柄</th><th>予測</th><th>モデル</th><th>7・14・28日の向き</th><th>予測したときの値</th><th>判定する時刻</th></tr></thead>
        <tbody>
          {open.length === 0 && <tr><td colspan="7" class="muted">ありません。</td></tr>}
          {open.slice(0, 40).map((p: any) => (
            <tr>
              <td class="ts">{jst(p.made_at)}</td>
              <td>{PAIR_LABEL[p.pair] ?? p.pair}</td>
              <td><span class={`tag ${p.direction}`}>{DIRECTION_LABEL[p.direction]}</span></td>
              <td class="mono">{p.model}</td>
              <td class="num"><Votes reason={p.reason} /></td>
              <td class="num">{yen(p.base_price)}</td>
              <td class="ts">{jst(p.target_at)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <span class="eyebrow"><span class="n">02</span> ／ 判定済み　{judged.length}件</span>
    <h2>答えが出た予測</h2>
    <div class="scroll">
      <table>
        <thead><tr><th>判定した時刻</th><th>銘柄</th><th>予測</th><th>予測したときの値</th><th>72時間後の値</th><th>動き</th><th>結果</th></tr></thead>
        <tbody>
          {judged.length === 0 && <tr><td colspan="7" class="muted">まだありません。予測は72時間後に判定します。</td></tr>}
          {judged.slice(0, 200).map((r: any) => (
            <tr>
              <td class="ts">{jst(r.target_at)}</td>
              <td>{PAIR_LABEL[r.pair] ?? r.pair}</td>
              <td><span class={`tag ${r.direction}`}>{DIRECTION_LABEL[r.direction]}</span></td>
              <td class="num">{yen(r.base_price)}</td>
              <td class="num">{yen(r.target_price)}</td>
              <td class={`num ${sign(r.move_pct)}`}>{pct(r.move_pct)}</td>
              <td>{r.hit === null ? '—' : r.hit ? '的中' : '外れ'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <span class="eyebrow"><span class="n">03</span> ／ 仮想の売買　{done.length}件</span>
    <h2>終わった売買</h2>
    <p class="lead">72時間を1件として数えます。そのときもまだ上がると読んでいれば売らずに持ち続けるので、そういう回は売買していません。</p>
    <p class="fine">手数料がかかるのは、買った回と売った回だけです。</p>
    <p class="fine">買った値と売った値は、その1時間の終値です。取引所に残る値なので、誰が計算しても同じ数字になります。</p>
    <div class="scroll">
      <table>
        <thead><tr><th>終わった時刻</th><th>銘柄</th><th>予測</th><th>何回目</th><th>買った値</th><th>72時間後の値</th><th>値動きだけ</th><th>引いた費用</th><th>残った損得</th></tr></thead>
        <tbody>
          {done.length === 0 && <tr><td colspan="9" class="muted">まだありません。1件目は買ってから72時間後に確定します。</td></tr>}
          {done.slice(0, 200).map((t: any) => (
            <tr>
              <td class="ts">{jst(t.close_at)}</td>
              <td>{PAIR_LABEL[t.pair] ?? t.pair}</td>
              <td><span class={`tag ${t.direction}`}>{DIRECTION_LABEL[t.direction]}</span></td>
              <td class="num">{t.seg ?? 1}{t.closes === false ? '（持ち越した）' : '（売った）'}</td>
              <td class="num">{yen(t.entry)}</td>
              <td class="num">{yen(t.exit)}</td>
              <td class={`num ${sign(t.gross_pct)}`}>{pct(t.gross_pct)}</td>
              <td class="num muted">{t.cost_pct ? `−${t.cost_pct}%` : '—'}</td>
              <td class={`num ${sign(t.net_pct)}`}>{pct(t.net_pct)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {exec && (
      <p class="fine">実行のずれ：{exec.n}件で、規則の値と、そのとき実際に板に並んでいた値の差は中央値{exec.gap_pct_median}%、最大{exec.gap_pct_max}%でした。記録が期限から遅れた時間は中央値{exec.late_minutes_median}分、最大{exec.late_minutes_max}分です。遅れるほど差が開きます。</p>
    )}
  </section>

  {(oldJudged.length > 0 || oldDone.length > 0) && (
    <section class="section">
      <span class="eyebrow"><span class="n">04</span> ／ 前のモデルと規則　{oldModels.join('・')}</span>
      <h2>前のモデルと規則の記録</h2>
      <p class="lead">モデルや売買の規則を替える前の記録です。消さずに、ここへ分けて残す。上の集計には入れていない。</p>
      <p class="fine">long-carry-v2 までの2件は、売る値を「動いた時点の板」で決めていました。2026年9月11日に実行が4時間半おくれ、その遅れがそのまま損得に乗っています。<a href="/method/">やり方</a>に経緯を書いています。</p>
      {oldJudged.length > 0 && (
        <div class="scroll">
          <table>
            <thead><tr><th>判定した時刻</th><th>銘柄</th><th>モデル</th><th>予測</th><th>予測したときの値</th><th>72時間後の値</th><th>動き</th><th>結果</th></tr></thead>
            <tbody>
              {oldJudged.slice(0, 200).map((r: any) => (
                <tr>
                  <td class="ts">{jst(r.target_at)}</td>
                  <td>{PAIR_LABEL[r.pair] ?? r.pair}</td>
                  <td class="mono">{r.model}</td>
                  <td><span class={`tag ${r.direction}`}>{DIRECTION_LABEL[r.direction]}</span></td>
                  <td class="num">{yen(r.base_price)}</td>
                  <td class="num">{yen(r.target_price)}</td>
                  <td class={`num ${sign(r.move_pct)}`}>{pct(r.move_pct)}</td>
                  <td>{r.hit === null ? '—' : r.hit ? '的中' : '外れ'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      {oldDone.length > 0 && (
        <div class="scroll" style="margin-top:18px">
          <table>
            <thead><tr><th>終わった時刻</th><th>銘柄</th><th>モデル／規則</th><th>予測</th><th>買った値</th><th>売った値</th><th>値動きだけ</th><th>引いた費用</th><th>残った損得</th></tr></thead>
            <tbody>
              {oldDone.slice(0, 200).map((t: any) => (
                <tr>
                  <td class="ts">{jst(t.close_at)}</td>
                  <td>{PAIR_LABEL[t.pair] ?? t.pair}</td>
                  <td class="mono">{t.model}／{t.rule ?? 'close-72h-v1'}</td>
                  <td><span class={`tag ${t.direction}`}>{DIRECTION_LABEL[t.direction]}</span></td>
                  <td class="num">{yen(t.entry)}</td>
                  <td class="num">{yen(t.exit)}</td>
                  <td class={`num ${sign(t.gross_pct)}`}>{pct(t.gross_pct)}</td>
                  <td class="num muted">{t.cost_pct ? `−${t.cost_pct}%` : '—'}</td>
                  <td class={`num ${sign(t.net_pct)}`}>{pct(t.net_pct)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
      <p class="fine" style="margin-top:12px">前のモデルで持っていたものを売るときは、いまの規則の費用で計算します。銘柄ごとの手数料と、「下」で売っていた場合はその保有にかかる費用です。</p>
    </section>
  )}
</Base>
