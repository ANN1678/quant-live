---
import '../styles/global.css';
import AnnMark from '../components/AnnMark.astro';
import { summary, jst } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  /** 検索に載せないページ（404）だけ true */
  noindex?: boolean;
  /** og:type。記事のときだけ article */
  ogType?: string;
  /** そのページ固有の構造化データ。会社とサイトの分は下で毎ページ出している */
  jsonld?: unknown[];
}

const {
  title,
  description = '相場を予測し、仮想で売買した結果を、当たった回も外した回もそのまま公開しています。リアルに移行する条件も数字で書いています。',
  noindex = false,
  ogType = 'website',
  jsonld = [],
} = Astro.props;

const SITE = 'https://ann1678.com';
const path = Astro.url.pathname;
const canonical = new URL(path, SITE).href;
const ogImage = `${SITE}/og.png`;

// ⚠ 品書きは英語にする（2026-09-12 CEO指示）。
//    5つとも、それぞれのページの札（eyebrow）と同じ語にそろえてある。
//    語を変えるなら、そのページの札も一緒に変えること。
const nav = [
  ['/', 'LIVE'],
  ['/record/', 'RECORD'],
  ['/method/', 'METHOD'],
  ['/posts/', 'NOTES'],
  ['/about/', 'ABOUT'],
];

// 会社とサイト。全ページに出す。
// ⚠ 住所と電話は載せていない。載せるなら登記の現況を確かめてから足すこと。
// ⚠ 表に出す名前は ANN。登記名は legalName にだけ置く（2026-09-10 CEO指示）。
const org = {
  '@type': 'Organization',
  '@id': `${SITE}/#org`,
  name: 'ANN',
  legalName: '株式会社ANN',
  url: `${SITE}/`,
  logo: { '@type': 'ImageObject', url: `${SITE}/icon-512.png`, width: 512, height: 512 },
  sameAs: ['https://x.com/ann_webstudio'],
};
const website = {
  '@type': 'WebSite',
  '@id': `${SITE}/#website`,
  url: `${SITE}/`,
  name: 'ANN',
  description: '相場の予測と仮想売買の記録を、書き換えない形で公開しているサイト。',
  inLanguage: 'ja',
  publisher: { '@id': `${SITE}/#org` },
};
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': [org, website, ...jsonld] });
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex
      ? <meta name="robots" content="noindex,follow" />
      : <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" />}

    <meta property="og:site_name" content="ANN" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="仮想通貨で勝てるモデルをつくる。ANN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@ann_webstudio" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* ⚠ .ico も置くこと。SVGを読まない相手（検索の一覧・古いSafari）が /favicon.ico を取りに来る */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* いちばん上が黒帯なので、端末の枠も黒に合わせる */}
    <meta name="theme-color" content="#000000" />
    <link rel="alternate" type="application/rss+xml" title="ANNの手記" href={`${SITE}/rss.xml`} />
    <link rel="sitemap" type="application/xml" href={`${SITE}/sitemap.xml`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&display=swap"
    />

    <script type="application/ld+json" set:html={graph} is:inline />
  </head>
  <body>
    {/* 動いていることを、いちばん上で1行だけ言う。値はエンジンが書いた summary.json から取る */}
    <div class="statusbar">
      <div class="wrap">
        <span class="live"><i aria-hidden="true"></i>稼働中</span>
        <span class="model">モデル <b>{summary?.model ?? '—'}</b></span>
        <span class="rule">規則 <b>{summary?.rule ?? '—'}</b></span>
        <span class="sync">最終更新 <b>{jst(summary?.generated_at)}</b></span>
        <span class="clock">日本時間 <b id="clock">--:--:--</b></span>
      </div>
    </div>

    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">
          <AnnMark id="mark-h" size={22} />
          ANN
        </a>
        <nav aria-label="サイト内">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path === href ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main><div class="wrap"><slot /></div></main>

    <footer class="site">
      <div class="wrap">
        <nav aria-label="足">
          {nav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <p class="fine">この記録は、投資の助言ではありません。売買を勧めるものでもありません。書いてあるのは、私たちが自分の仮説を試して、その結果を数えたものだけです。金融商品取引法にいう投資助言・代理業の登録は受けていません。</p>
        <p class="legal">© {new Date().getFullYear()} ANN</p>
        {/* サーバーの死活監視（~/care/monitor.sh）が10分ごとにこの印を探す。消すと監視が鳴る。 */}
        <!-- ann-render-ok -->
      </div>
    </footer>

    {/* 秒で動くものを、ここで全部まとめて回す。
        黒帯の時計と、data-from（そこから何が経ったか）と data-until（そこまであと何か）。
        ⚠ setInterval は1本だけにする。要素ごとに立てない。 */}
    <script is:inline>
      (function () {
        var clock = document.getElementById('clock');
        var timers = document.querySelectorAll('[data-from],[data-until]');
        if (!clock && !timers.length) return;

        var f = new Intl.DateTimeFormat('ja-JP', {
          timeZone: 'Asia/Tokyo', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false,
        });
        function pad(n) { return n < 10 ? '0' + n : '' + n; }
        function span(ms) {
          var s = Math.floor(Math.max(0, ms) / 1000);
          var d = Math.floor(s / 86400); s -= d * 86400;
          var h = Math.floor(s / 3600); s -= h * 3600;
          var m = Math.floor(s / 60); s -= m * 60;
          return (d > 0 ? d + '日 ' : '') + pad(h) + ':' + pad(m) + ':' + pad(s);
        }
        function tick() {
          var now = Date.now();
          if (clock) clock.textContent = f.format(new Date(now));
          for (var i = 0; i < timers.length; i++) {
            var el = timers[i];
            var from = el.getAttribute('data-from');
            if (from) { el.textContent = span(now - Number(from)); continue; }
            var left = Number(el.getAttribute('data-until')) - now;
            el.textContent = left <= 0 ? 'まもなく' : span(left);
          }
        }
        tick();
        setInterval(tick, 1000);
      })();
    </script>
  </body>
</html>
